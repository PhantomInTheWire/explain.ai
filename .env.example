# Backend Configuration
REDIS_URL=redis://redis:6379
WEAVIATE_URL=http://weaviate:8080
DATA_DIR=/data/sessions
SESSION_TTL_SECONDS=3600
MAX_CONCURRENT_JOBS=3
CLEANUP_INTERVAL_SECONDS=300
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
DEBUG=false

# ARQ Worker Configuration
ARQ_MAX_JOBS=10  # Max concurrent jobs for default worker (PDF, PPT, audio processing)
ARQ_VIDEO_MAX_JOBS=1  # Max concurrent video jobs - increase with more CPU cores/better GPU

# Video Encoding GPU Acceleration
# Choose based on your hardware:
#   h264_videotoolbox - macOS (Apple Silicon/AMD GPU) - Default on macOS
#   h264_nvenc - Linux/Windows with NVIDIA GPU
#   h264_qsv - Intel Quick Sync Video (Intel iGPU)
#   libx264 - CPU-only fallback (slowest)
VIDEO_GPU_CODEC=h264_videotoolbox

# Google Cloud API Keys (Required)
GOOGLE_API_KEY=your-google-api-key-here
CONVERTAPI_KEY=your-convertapi-key-here

# Google Cloud Credentials
# Place your credentials.json file in the project root
# It will be mounted into the container at /app/credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# Frontend Configuration
VITE_API_URL=http://localhost:8000
